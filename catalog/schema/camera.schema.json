{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:halfpress:schema:camera",
  "title": "Camera body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "type", "maker", "model", "mount",
    "sensor", "cropFactor", "stabilization", "shutter", "iso", "source"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "urn:halfpress:schema:common#/$defs/id" },
    "type": { "const": "camera" },
    "maker": { "$ref": "urn:halfpress:schema:common#/$defs/name" },
    "model": { "$ref": "urn:halfpress:schema:common#/$defs/name" },
    "mount": {
      "description": "Id of an entry in catalog/mounts.",
      "$ref": "urn:halfpress:schema:common#/$defs/id"
    },
    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "widthMm", "heightMm"],
      "properties": {
        "format": { "$ref": "#/$defs/format" },
        "widthMm": { "$ref": "urn:halfpress:schema:common#/$defs/positiveNumber" },
        "heightMm": { "$ref": "urn:halfpress:schema:common#/$defs/positiveNumber" },
        "megapixels": { "$ref": "urn:halfpress:schema:common#/$defs/positiveNumber" }
      }
    },
    "cropFactor": {
      "type": "number",
      "minimum": 0.3,
      "maximum": 8
    },
    "stabilization": {
      "description": "In-body image stabilization.",
      "$ref": "urn:halfpress:schema:common#/$defs/stabilization"
    },
    "shutter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanicalFastest", "longestTimed"],
      "properties": {
        "mechanicalFastest": { "$ref": "urn:halfpress:schema:common#/$defs/shutterSpeed" },
        "electronicFastest": { "$ref": "urn:halfpress:schema:common#/$defs/shutterSpeed" },
        "longestTimed": {
          "description": "Longest exposure the camera times itself before Bulb.",
          "$ref": "urn:halfpress:schema:common#/$defs/shutterSpeed"
        },
        "bulb": { "type": "boolean" }
      }
    },
    "iso": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 1 },
        "max": { "type": "integer", "minimum": 1 },
        "expandedMax": { "type": "integer", "minimum": 1 }
      }
    },
    "battery": { "$ref": "urn:halfpress:schema:common#/$defs/name" },
    "weightG": { "$ref": "urn:halfpress:schema:common#/$defs/positiveNumber" },
    "source": { "$ref": "urn:halfpress:schema:common#/$defs/source" }
  },
  "$defs": {
    "format": {
      "enum": ["medium-format", "full-frame", "aps-c", "micro-four-thirds", "one-inch"]
    }
  }
}
