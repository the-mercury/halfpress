{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:halfpress:schema:adapter",
  "title": "Mount adapter or filter step ring",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "type", "maker", "model", "kind", "from", "to", "source"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "urn:halfpress:schema:common#/$defs/id" },
    "type": { "const": "adapter" },
    "maker": { "$ref": "urn:halfpress:schema:common#/$defs/name" },
    "model": { "$ref": "urn:halfpress:schema:common#/$defs/name" },
    "kind": { "enum": ["mount-adapter", "step-up-ring", "step-down-ring"] },
    "from": {
      "description": "Mount adapter: the lens mount id it accepts. Step ring: the lens thread in mm."
    },
    "to": {
      "description": "Mount adapter: the body mount id it fits. Step ring: the filter size in mm."
    },
    "passesAutofocus": { "type": "boolean" },
    "passesStabilization": { "type": "boolean" },
    "source": { "$ref": "urn:halfpress:schema:common#/$defs/source" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "mount-adapter" } } },
      "then": {
        "required": ["passesAutofocus"],
        "properties": {
          "from": { "$ref": "urn:halfpress:schema:common#/$defs/id" },
          "to": { "$ref": "urn:halfpress:schema:common#/$defs/id" }
        }
      },
      "else": {
        "properties": {
          "from": { "$ref": "urn:halfpress:schema:common#/$defs/positiveNumber" },
          "to": { "$ref": "urn:halfpress:schema:common#/$defs/positiveNumber" },
          "passesAutofocus": false,
          "passesStabilization": false
        }
      }
    }
  ]
}
