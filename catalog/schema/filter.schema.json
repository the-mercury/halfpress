{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:halfpress:schema:filter",
  "title": "Filter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "type", "maker", "model", "kind", "sizeMm", "attach", "source"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "urn:halfpress:schema:common#/$defs/id" },
    "type": { "const": "filter" },
    "maker": {
      "description": "Brand, or \"Generic\" for a filter type that is not tied to one product.",
      "$ref": "urn:halfpress:schema:common#/$defs/name"
    },
    "model": { "$ref": "urn:halfpress:schema:common#/$defs/name" },
    "kind": { "enum": ["uv", "protector", "cpl", "nd", "variable-nd", "other"] },
    "ndFactor": {
      "description": "Light reduction factor of a fixed ND filter, e.g. 1000 for ND1000.",
      "type": "number",
      "exclusiveMinimum": 1
    },
    "ndStops": {
      "description": "Stop range of a variable ND filter.",
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 }
      }
    },
    "lightLossStops": {
      "description": "Light lost by a non-ND filter such as a CPL, when the maker states it.",
      "type": "number",
      "minimum": 0,
      "maximum": 4
    },
    "sizeMm": {
      "description": "Filter diameter in millimetres.",
      "$ref": "urn:halfpress:schema:common#/$defs/positiveNumber"
    },
    "attach": { "enum": ["screw-in", "magnetic", "drop-in"] },
    "source": { "$ref": "urn:halfpress:schema:common#/$defs/source" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "nd" } } },
      "then": { "required": ["ndFactor"] }
    },
    {
      "if": { "properties": { "kind": { "const": "variable-nd" } } },
      "then": { "required": ["ndStops"] }
    }
  ]
}
