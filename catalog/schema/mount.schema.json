{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:halfpress:schema:mount",
  "title": "Lens mount",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "type", "name", "maker", "formats", "source"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "urn:halfpress:schema:common#/$defs/id" },
    "type": { "const": "mount" },
    "name": { "$ref": "urn:halfpress:schema:common#/$defs/name" },
    "maker": { "$ref": "urn:halfpress:schema:common#/$defs/name" },
    "flangeMm": {
      "description": "Flange focal distance in millimetres.",
      "$ref": "urn:halfpress:schema:common#/$defs/positiveNumber"
    },
    "formats": {
      "description": "Sensor formats this mount is used with.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "urn:halfpress:schema:camera#/$defs/format" }
    },
    "source": { "$ref": "urn:halfpress:schema:common#/$defs/source" }
  }
}
